# GitHub REST API token used to retrieve repository details and contents.
VITE_GITHUB_API_KEY=your_github_personal_access_token

# Local Ollama API. No cloud LLM API key is required for text generation.
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=phi3:latest

# Optional explicit mock mode for UI-only testing; keep false for real AI.
VITE_USE_MOCK_AI=false
